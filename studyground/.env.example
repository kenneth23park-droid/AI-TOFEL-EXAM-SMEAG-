# Switch the whole app with one variable.
APP_MODE=local            # local | cloud

# --- cloud only ---
# Supabase → Project settings → Database → Connection string (URI)
DATABASE_URL=postgresql://postgres:PASSWORD@db.PROJECT.supabase.co:5432/postgres
# 채점·피드백 LLM. 키가 있는 쪽만 호출한다.
# LLM_PROVIDER=both 면 anthropic → openai 순으로 시도하고, 앞이 실패하면 뒤가 이어받는다.
LLM_PROVIDER=both         # both | anthropic | openai
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# --- optional ---
DEFAULT_LANG=en           # UI default is English; ko is the toggle
SEED_ON_START=1           # seed an empty DB on boot
# SQLITE_PATH=./data/studyground.db
