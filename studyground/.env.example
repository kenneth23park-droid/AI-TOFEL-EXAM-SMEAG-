# Switch the whole app with one variable.
APP_MODE=local            # local | cloud

# --- cloud only ---
# Supabase → Project settings → Database → Connection string (URI)
DATABASE_URL=postgresql://postgres:PASSWORD@db.PROJECT.supabase.co:5432/postgres
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# --- optional ---
DEFAULT_LANG=en           # UI default is English; ko is the toggle
SEED_ON_START=1           # seed an empty DB on boot
# SQLITE_PATH=./data/studyground.db
