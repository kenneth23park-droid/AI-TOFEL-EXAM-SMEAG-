# Switch the whole app with one variable.
APP_MODE=local            # local | cloud

# --- cloud only ---
# Supabase → Project settings → Database → Connection string (URI)
DATABASE_URL=postgresql://postgres:PASSWORD@db.PROJECT.supabase.co:5432/postgres
# 채점·피드백 LLM. 키가 있는 쪽만 호출한다.
# LLM_PROVIDER=both 면 anthropic → openai 순으로 시도하고, 앞이 실패하면 뒤가 이어받는다.
LLM_PROVIDER=both         # both | anthropic | openai
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
# sg2/api/score.js and sg2/api/feedback.js need this on the server only.
SUPABASE_SERVICE_ROLE_KEY=

# --- 대본 → 음성 (sg2/api/tts.js) ---
# 이 엔드포인트를 여는 공용 토큰. 없으면 /api/tts 는 503 으로 닫힌 채 있는다
# (열어 두면 남의 요청이 그대로 우리 계정에 과금된다).
SG_TTS_TOKEN=
# 엔진은 키가 있는 것만 화면에 열린다. 한 세트는 한 엔진으로 끝까지 만든다 —
# 섞으면 문항마다 목소리가 튄다.
#   elevenlabs  SET 9 정본과 같은 목소리. 기본값이고, 있는 문항을 다시 만들 때는 이것.
#   openai      위의 OPENAI_API_KEY 를 그대로 쓴다(키를 하나만 둘 때 가장 간단).
#   google      en-US/GB/AU/IN 억양 폭이 가장 넓다. Cloud Console 의 API 키.
#   deepgram    가장 싸고 빠르다. 속도 조절은 없다.
ELEVENLABS_API_KEY=
GOOGLE_TTS_API_KEY=
DEEPGRAM_API_KEY=

# --- optional ---
DEFAULT_LANG=en           # UI default is English; ko is the toggle
SEED_ON_START=1           # seed an empty DB on boot
# SQLITE_PATH=./data/studyground.db
