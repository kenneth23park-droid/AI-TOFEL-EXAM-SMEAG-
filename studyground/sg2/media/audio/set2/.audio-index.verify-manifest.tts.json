    "set2-l1-q19-20": {
      "scriptHash": "8a37f46a2f9816867d02323d8cbedf9c876a4758ca044056e92b50332fa5c639",
      "sigVersion": 3,
      "bytes": 216546,
      "durationSec": 13.47,
      "audioSha256": "7cbeb846790aff4cd620160abcc028931934b8ec5ecd069723dc341e17cf3cc5",
      "stt": {
        "verdict": "WARN",
        "wer": 0.0238,
        "backend": "faster_whisper",
        "reason": "WER 2.4% — queue for a human listen",
        "transcript": "Class, I have an important notice. The main dining hall will close for renovations starting next Monday and will remain closed for two weeks. During this time, meals will be served at the West Campus Cafe instead. Please plan your schedules accordingly.",
        "audioSha256": "7cbeb846790aff4cd620160abcc028931934b8ec5ecd069723dc341e17cf3cc5",
        "scriptHash": "8a37f46a2f9816867d02323d8cbedf9c876a4758ca044056e92b50332fa5c639"
