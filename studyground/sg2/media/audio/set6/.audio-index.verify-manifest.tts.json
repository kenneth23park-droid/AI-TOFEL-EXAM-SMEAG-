      "sigVersion": 3,
      "bytes": 262726,
      "durationSec": 25.52,
      "audioSha256": "8d8a14a52a517960c46b04acdbad0a0ae6b5d40954543e4a7e1cd85cfa13ebf8",
      "stt": {
