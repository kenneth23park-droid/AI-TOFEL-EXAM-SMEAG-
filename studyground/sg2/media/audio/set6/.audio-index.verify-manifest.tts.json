      }
    },
    "set6-l1-q17-20": {
      "scriptHash": "9f559e30dd6f9133f039bf971da39221830c7453af80826c36bea145cb295587",
      "sigVersion": 3,
      "bytes": 1351306,
      "durationSec": 84.38,
      "audioSha256": "891cb36600d7930d2ec062929c5b6fd96c155f03e4b8437d42565800914ebfec",
      "stt": {
        "verdict": "PASS",
        "wer": 0.0044,
        "backend": "faster_whisper",
        "reason": "WER 0.4%",
        "transcript": "Today I want to compare two fundamental types of learning that psychologists have studied extensively classical conditioning and inoperant conditioning. They might sound similar, but they work in quite different ways. Let's start with classical conditioning. This was first described through experiments with dogs. The basic idea is that an organism learns to associate two stimuli together. For example, if a bell rings every time before food appears, eventually the sound of the bell alone will trigger a response like salivating. The learner is passive here. They're not doing anything to make the food appear. They simply learn that one thing predicts another. Now, operant conditioning works differently. Here, learning happens through consequences. The organism actively does something. And what happens afterward determines whether they'll do it again. If a behavior leads to a reward, it's more likely to be repeated. If it leads to something unpleasant, it's less likely to happen again. So the learner is active. Their behavior actually influences the outcome. Here's a simple way to remember the difference. In classical conditioning, the response comes before any action. It's automatic. In operant conditioning, the behavior comes first, then the consequence. Both types of learning are important and happen constantly in our daily lives, often without us even realizing it. Next, we will explore how these principles are applied in education and therapy.",
        "audioSha256": "891cb36600d7930d2ec062929c5b6fd96c155f03e4b8437d42565800914ebfec",
        "scriptHash": "9f559e30dd6f9133f039bf971da39221830c7453af80826c36bea145cb295587"
      }
    },
