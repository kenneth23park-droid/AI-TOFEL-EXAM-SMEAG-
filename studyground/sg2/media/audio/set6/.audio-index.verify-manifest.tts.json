      "durationSec": 20.06,
      "audioSha256": "93da63cb8a04430995a12a089e6d09451f4700ee4e59112aab3160e46a1e26df",
      "stt": {
        "verdict": "WARN",
        "wer": 0.0435,
        "backend": "faster_whisper",
        "reason": "WER 4.3% — queue for a human listen",
