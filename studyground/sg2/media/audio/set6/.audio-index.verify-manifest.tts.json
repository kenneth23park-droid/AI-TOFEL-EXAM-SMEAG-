      "durationSec": 29.81,
      "audioSha256": "dfc8172b252e04ad48fddf9d6fa1cc7608b5b18866597da3c3124444e7719c0e",
      "stt": {
        "verdict": "PASS",
        "wer": 0.0,
        "backend": "faster_whisper",
        "reason": "WER 0.0%",
        "transcript": "Great news, our professional writing certification program is now accepting applications. This year, we've added modules on digital content strategy and technical communication. You'll work with published authors and receive personalized feedback on your portfolio. The program runs eight weeks during spring semester. To register, visit the Humanities Building, Room 203, and submit a writing sample along with your completed application form. Spots are limited, so apply early.",
        "audioSha256": "dfc8172b252e04ad48fddf9d6fa1cc7608b5b18866597da3c3124444e7719c0e",
