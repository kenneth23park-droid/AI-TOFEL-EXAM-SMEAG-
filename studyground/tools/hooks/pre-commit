#!/bin/sh
# 겹침 리포트 자동생성 — 커밋 직전에 돈다.
#
# 왜 훅인가. config/dup-report.* 는 사람이 dup_check.js 를 기억해서 돌려야 갱신되는
# 파일이었다. 그래서 낡았고, 낡은 리포트는 화면에 "겹침 없음"이라고 거짓말을 한다 —
# SET9 스피킹 지시문 겹침이 실제로 그렇게 며칠 묻혀 있었다. 검사기를 만들어 놓고
# 돌리는 것을 사람 기억에 맡기면 검사기가 없는 것과 같다.
#
# 하는 일
#   1) 문항 팩·대본·검사기 자체가 이번 커밋에 들어 있으면 리포트를 다시 만든다.
#   2) 새로 만든 리포트를 이번 커밋에 같이 담는다(스테이징).
#   3) 겹침 high 가 있으면 커밋을 멈추고 어디가 겹쳤는지 보여 준다.
#
# 관계없는 커밋(문서·CSS 등)에서는 아무 일도 하지 않는다 — 매번 도는 훅은 곧 꺼진다.
#
# 정말 급하면 빠져나갈 수 있다:  git commit --no-verify
# 그래도 배포는 막힌다(.github/workflows/deploy-sg2.yml 이 같은 검사를 다시 돌린다).
#
# 설치:  sh studyground/tools/hooks/install.sh

set -e

ROOT=$(git rev-parse --show-toplevel)
cd "$ROOT"

# ── 판 번호 ──────────────────────────────────────────────────
# sw.js 의 VERSION 이 이번 커밋에 들어 있으면 version.json 과 build-version.js 를
# 다시 만들어 같이 담는다. 이 둘은 손으로 갱신하는 파일이면 반드시 낡고, 낡은
# version.json 은 내려받은 사본에게 "당신은 최신입니다"라고 거짓말을 한다 —
# 판올림 알림을 만들어 놓고 스스로 침묵시키는 셈이다.
if git diff --cached --name-only | grep -q '^studyground/sg2/sw\.js$'; then
  if command -v python3 >/dev/null 2>&1; then
    python3 studyground/sg2/tools/build_version.py >/dev/null
    git add studyground/sg2/version.json studyground/sg2/assets/build-version.js
    echo "pre-commit: 판 번호를 sw.js 에 맞춰 다시 새겼습니다."
  else
    echo "pre-commit: python3 가 없어 판 번호 갱신을 건너뜁니다." >&2
  fi
fi

# 이번 커밋이 겹침 판정에 영향을 주는가. 아니면 조용히 지나간다.
if ! git diff --cached --name-only | grep -qE '^studyground/(sg2/assets/set[0-9a-z]+\.js|sg2/config/_.*_fragments/|sg2/config/dup-allowlist\.json|sg2/assets/dup-core\.js|tools/dup_check\.js)'; then
  exit 0
fi

command -v node >/dev/null 2>&1 || {
  echo "pre-commit: node 가 없어 겹침 검사를 건너뜁니다." >&2
  exit 0
}

echo "pre-commit: 문항이 바뀌었습니다 — 겹침 검사를 돌립니다."

if node studyground/tools/dup_check.js --quiet; then
  # 통과. 다시 만든 리포트를 이번 커밋에 같이 담는다.
  git add studyground/sg2/config/dup-report.json studyground/sg2/config/dup-report.js
  echo "pre-commit: 겹침 없음 — 갱신된 리포트를 이번 커밋에 담았습니다."
  exit 0
fi

# 실패 — 무엇이 겹쳤는지 그 자리에서 보여 준다. 종료코드만 던지면 아무도 안 본다.
echo "" >&2
node studyground/tools/dup_check.js >&2 || true
echo "" >&2
echo "커밋을 멈췄습니다. 겹친 문항을 바꾸거나, 겹침이 아니라면" >&2
echo "studyground/sg2/config/dup-allowlist.json 에 사유와 함께 적어 주세요." >&2
echo "자세히 보기: studyground/sg2/admin-dup.html  (한 줄을 누르면 두 문항이 나란히 펼쳐집니다)" >&2
exit 1
