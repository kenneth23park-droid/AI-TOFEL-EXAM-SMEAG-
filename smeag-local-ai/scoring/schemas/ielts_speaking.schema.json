{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "IELTS Speaking — structured band report (transcript-based + audio features)",
  "type": "object",
  "additionalProperties": false,
  "required": ["criteria", "overall_band", "part_no", "summary_ko", "summary_en"],
  "properties": {
    "part_no": { "type": "integer", "enum": [1, 2, 3] },
    "criteria": {
      "type": "object",
      "additionalProperties": false,
      "required": ["FC", "LR", "GRA", "PRO"],
      "properties": {
        "FC":  { "$ref": "#/$defs/criterion" },
        "LR":  { "$ref": "#/$defs/criterion" },
        "GRA": { "$ref": "#/$defs/criterion" },
        "PRO": { "$ref": "#/$defs/criterion" }
      }
    },
    "overall_band": { "type": "number", "minimum": 1.0, "maximum": 9.0, "multipleOf": 0.5 },
    "fluency_metrics": {
      "type": "object",
      "additionalProperties": false,
      "description": "Computed by the pipeline from the ASR word timestamps, NOT estimated by the LLM.",
      "properties": {
        "words_per_minute": { "type": "number" },
        "filled_pause_rate": { "type": "number", "description": "um/uh per 100 words" },
        "long_pause_count":  { "type": "integer", "description": "silences > 2.0s inside a turn" },
        "speech_ratio":      { "type": "number", "description": "voiced time / total time" }
      }
    },
    "pronunciation_flags": {
      "type": "array",
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["word", "issue"],
        "properties": {
          "word": { "type": "string" },
          "issue": { "type": "string" },
          "asr_confidence": { "type": "number", "minimum": 0, "maximum": 1 }
        }
      }
    },
    "next_steps": { "type": "array", "maxItems": 3, "items": { "type": "string" } },
    "summary_en": { "type": "string" },
    "summary_ko": { "type": "string" }
  },
  "$defs": {
    "criterion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["band", "evidence", "rationale"],
      "properties": {
        "band": { "type": "number", "minimum": 1.0, "maximum": 9.0, "multipleOf": 0.5 },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4,
          "items": { "type": "string" },
          "description": "VERBATIM spans from the ASR transcript."
        },
        "rationale": { "type": "string" }
      }
    }
  }
}
