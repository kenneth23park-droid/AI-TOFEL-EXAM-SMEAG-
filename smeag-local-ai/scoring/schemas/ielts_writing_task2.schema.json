{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "IELTS Writing Task 2 — structured band report",
  "type": "object",
  "additionalProperties": false,
  "required": ["criteria", "overall_band", "word_count", "off_topic", "summary_ko", "summary_en"],
  "properties": {
    "criteria": {
      "type": "object",
      "additionalProperties": false,
      "required": ["TR", "CC", "LR", "GRA"],
      "properties": {
        "TR": { "$ref": "#/$defs/criterion" },
        "CC": { "$ref": "#/$defs/criterion" },
        "LR": { "$ref": "#/$defs/criterion" },
        "GRA": { "$ref": "#/$defs/criterion" }
      }
    },
    "overall_band": {
      "type": "number",
      "description": "Mean of the four criterion bands, rounded to the nearest 0.5 (IELTS rounding: .25 -> up, .75 -> up).",
      "minimum": 1.0,
      "maximum": 9.0,
      "multipleOf": 0.5
    },
    "word_count": { "type": "integer", "minimum": 0 },
    "off_topic": {
      "type": "boolean",
      "description": "true if the response does not address the prompt. Forces TR <= 4."
    },
    "corrections": {
      "type": "array",
      "description": "Sentence-level corrections. Max 12, highest-impact first.",
      "maxItems": 12,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["original", "corrected", "error_type"],
        "properties": {
          "original": { "type": "string" },
          "corrected": { "type": "string" },
          "error_type": {
            "type": "string",
            "enum": ["article", "tense", "agreement", "preposition", "word_choice",
                     "collocation", "spelling", "punctuation", "fragment",
                     "run_on", "word_form", "register", "cohesion"]
          },
          "note_ko": { "type": "string" }
        }
      }
    },
    "next_steps": {
      "type": "array",
      "maxItems": 3,
      "items": { "type": "string" },
      "description": "Actionable study advice, most impactful first."
    },
    "summary_en": { "type": "string" },
    "summary_ko": { "type": "string" }
  },
  "$defs": {
    "criterion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["band", "evidence", "rationale"],
      "properties": {
        "band": {
          "type": "number",
          "minimum": 1.0,
          "maximum": 9.0,
          "multipleOf": 0.5
        },
        "evidence": {
          "type": "array",
          "description": "VERBATIM quotes from the student's response. Must appear character-for-character in the submission. Empty array is NOT acceptable unless the response is blank.",
          "minItems": 1,
          "maxItems": 4,
          "items": { "type": "string" }
        },
        "rationale": {
          "type": "string",
          "description": "1-3 sentences tying the quoted evidence to the public band descriptor for this band."
        }
      }
    }
  }
}
