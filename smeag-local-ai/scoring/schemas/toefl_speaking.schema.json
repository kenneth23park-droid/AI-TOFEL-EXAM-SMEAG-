{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TOEFL Speaking — structured rubric report (transcript-based)",
  "type": "object",
  "additionalProperties": false,
  "required": ["criteria", "overall", "word_count", "is_blank", "summary_ko", "summary_en"],
  "properties": {
    "criteria": {
      "type": "object",
      "additionalProperties": false,
      "required": ["DEL", "LU", "TD"],
      "properties": {
        "DEL": { "$ref": "#/$defs/delivery" },
        "LU": { "$ref": "#/$defs/criterion" },
        "TD": { "$ref": "#/$defs/criterion" }
      }
    },
    "overall": {
      "type": "number",
      "description": "Mean of the three criterion scores, rounded to the nearest 0.5 (.25 and .75 round up).",
      "minimum": 0,
      "maximum": 4,
      "multipleOf": 0.5
    },
    "word_count": { "type": "integer", "minimum": 0 },
    "is_blank": {
      "type": "boolean",
      "description": "true when no speech was recorded. Forces every criterion to 0."
    },
    "fluency_metrics": {
      "type": "object",
      "description": "Echoed back from the pipeline when supplied; never invented by the model.",
      "additionalProperties": false,
      "properties": {
        "words_per_minute": { "type": "number", "minimum": 0 },
        "filled_pause_rate": { "type": "number", "minimum": 0 },
        "long_pause_count": { "type": "integer", "minimum": 0 },
        "speech_ratio": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    },
    "next_steps": {
      "type": "array",
      "maxItems": 3,
      "items": { "type": "string" },
      "description": "Actionable study advice, most impactful first."
    },
    "summary_en": { "type": "string" },
    "summary_ko": { "type": "string" }
  },
  "$defs": {
    "criterion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["score", "evidence", "rationale"],
      "properties": {
        "score": { "type": "number", "minimum": 0, "maximum": 4, "multipleOf": 0.5 },
        "evidence": {
          "type": "array",
          "description": "VERBATIM spans from the transcript. Empty array is NOT acceptable unless is_blank is true.",
          "minItems": 1,
          "maxItems": 4,
          "items": { "type": "string" }
        },
        "rationale": { "type": "string" }
      }
    },
    "delivery": {
      "type": "object",
      "additionalProperties": false,
      "required": ["score", "evidence", "rationale"],
      "properties": {
        "score": {
          "type": "number",
          "description": "Capped at 3 — Delivery 4 is not awardable from a transcript.",
          "minimum": 0,
          "maximum": 3,
          "multipleOf": 0.5
        },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4,
          "items": { "type": "string" }
        },
        "rationale": { "type": "string" }
      }
    }
  }
}
